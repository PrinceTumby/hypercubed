{
  "arch": "mips",
  "cpu": "r5900",
  "llvm-target": "mipsel-unknown-none-n32",
  "features": "+noabicalls,+soft-float,+short-loop-bug",
  "metadata": {
    "description": "MIPS (LE) Sony PlayStation 2 (PS2)",
    "host_tools": false,
    "std": false,
    "tier": 4
  },
  "data-layout": "e-m:m-p:32:32-i8:8:32-i16:16:32-i64:64-n32-S64",
  "no-builtins": true,
  "vendor": "sony",
  "target-endian": "little",
  "target-pointer-width": "32",
  "max-atomic-width": 32,
  "os": "ps2",
  "env": "",
  "dynamic-linking": false,
  "relocation-model": "static",
  "executables": false,
  "position-independent-executables": false,
  "exe-suffix": "",
  "has-rpath": false,
  "linker-flavor": "ld.lld",
  "linker": "rust-lld",
  "panic-strategy": "abort",
  "no-default-libraries": true
}
