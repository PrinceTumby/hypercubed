{
  "arch": "powerpc",
  "cpu": "g3",
  "llvm-target": "powerpc-unknown-none-aix",
  "binary-format": "mach-o",
  "features": "",
  "metadata": {
    "description": "PowerPC Apple Mac OS X (10.4+, Tiger+)",
    "host_tools": false,
    "std": false,
    "tier": 3
  },
  "data-layout": "E-m:a-p:32:32-Fi32-i64:64-n32",
  "vendor": "appleold",
  "abi": "aix",
  "target-endian": "big",
  "target-pointer-width": "32",
  "max-atomic-width": 32,
  "os": "macos",
  "env": "",
  "dynamic-linking": true,
  "dll-suffix": ".dylib",
  "executables": true,
  "position-independent-executables": true,
  "exe-suffix": "",
  "has-rpath": false,
  "linker-flavor": "ld.lld",
  "linker": "rust-lld",
  "panic-strategy": "abort",
  "no-default-libraries": true
}
